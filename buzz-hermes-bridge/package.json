{
  "name": "@assurance-toto/buzz-hermes-bridge",
  "version": "0.1.0",
  "description": "Security/correlation checkpoint between the Buzz workspace (collaboration/identity/approvals) and the Hermes agent runtime.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "init-buzz-keys": "tsx scripts/init-buzz-keys.ts",
    "verify-audit": "tsx scripts/verify-audit.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "nostr-tools": "^2.12.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
