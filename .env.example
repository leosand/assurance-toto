# .env.example — Assurance Toto (docker-compose.lite.yml / docker-compose.yml)
# Copier en `.env` (`cp .env.example .env`) puis remplir.
# AUCUNE valeur réelle ici — les secrets générés ne vivent que dans `.env`
# (gitignored). DNS-safe : les noms d'hôtes internes respectent RFC 1123.

# --- PostgreSQL métier (service `postgres`) ---
PG_DB=assurance_toto
PG_USER=toto
PG_PASSWORD=change_me_pg      # générer : openssl rand -hex 24
PG_HOST=postgres              # hostname interne compose (hôte : localhost:5432 non exposé)
PG_PORT=5433   # port hôte (à changer si 5433 déjà pris)

# --- Redis (service `redis`, mot de passe obligatoire) ---
REDIS_PASSWORD=change_me_redis  # générer : openssl rand -hex 24

# --- Buzz : base dédiée du relais (service `postgres-buzz`, SÉPARÉE du métier) ---
BUZZ_PG_DB=buzz
BUZZ_PG_USER=buzz
BUZZ_PG_PASSWORD=change_me_buzz_pg  # générer : openssl rand -hex 24

# --- Buzz : stockage média S3 local (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio   # >= 8 caractères
BUZZ_S3_ACCESS_KEY=minioadmin         # réutilise le compte root MinIO (démo)
BUZZ_S3_SECRET_KEY=change_me_minio
BUZZ_S3_BUCKET=buzz-media

# --- Buzz : identité Nostr (relay + bridge) ---
# Générer la paire du relais + dériver les npub :
#   cd buzz-hermes-bridge && npm run init-buzz-keys   (écrit .env.buzz, chmod 600)
# ou openssl rand -hex 32 (clés hex 64 chars). Aucune clé réelle ici.
BUZZ_RELAY_PRIVATE_KEY=npub_hex_or_placeholder
RELAY_OWNER_PUBKEY=npub_hex_or_placeholder          # hex 64 chars — identité CEO propriétaire du relais
BUZZ_PRIVATE_KEY=npub_hex_or_placeholder            # nsec1... ou hex64 du BRIDGE (absent ⇒ NullCollabAdapter, démo sans Buzz)
BRIDGE_CEOPUBKEYS=npub_hex_or_placeholder           # CSV de npub/hex CEO whitelistés (vide ⇒ tout deny)
BRIDGE_ALLOWED_UNSIGNED_ROLES=npub_hex_or_placeholder  # CSV npub/hex d'agents acceptés SANS signature (Phase 1 ; jamais un npub CEO)

# --- Buzz ↔ Hermes (politique métier) ---
CLAIM_SETTLEMENT_THRESHOLD_EUR=5000   # plafond règlement sinistre autonome (au-delà ⇒ approbation CEO)
BRIDGE_REQUIRE_SIGNED_COMMANDS=false  # démo locale ; PROD : true (events Nostr signés requis côté CEO)

# --- Ollama (NATIF sur l'hôte Windows, PAS de conteneur) ---
# Un SEUL modèle LLM chargé à la fois (~6-8 Go RAM) — ne pas paralléliser gemma4:e4b + hermes3:8b.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_PRIMARY=gemma4:e4b
OLLAMA_MODEL_LONG_CTX=gemma4:e4b-16k
OLLAMA_MODEL_FALLBACK=hermes3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CONTEXT_SIZE=8192

# --- Agents Hermes : mode d'approbation / seuils ---
HERMES_APPROVAL_MODE=on-risk          # on-risk | always | never
HERMES_ESCALATION_THRESHOLD_EUR=5000  # seuil d'escalade agent → CEO
HERMES_LOG_LEVEL=info

# --- Identités Nostr par agent (un nsec/npub par département ; vide = non signé) ---
# nsec jamais publiés ; npub publics (réutilisés dans BRIDGE_ALLOWED_UNSIGNED_ROLES).
AGENT_NSEC_ORCHESTRATEUR=npub_hex_or_placeholder
AGENT_NPUB_ORCHESTRATEUR=npub_hex_or_placeholder
AGENT_NSEC_SALES=npub_hex_or_placeholder
AGENT_NPUB_SALES=npub_hex_or_placeholder
AGENT_NSEC_SOUSCRIPTION=npub_hex_or_placeholder
AGENT_NPUB_SOUSCRIPTION=npub_hex_or_placeholder
AGENT_NSEC_SINISTRES=npub_hex_or_placeholder
AGENT_NPUB_SINISTRES=npub_hex_or_placeholder
AGENT_NSEC_FINANCE=npub_hex_or_placeholder
AGENT_NPUB_FINANCE=npub_hex_or_placeholder
AGENT_NSEC_SUPPORT=npub_hex_or_placeholder
AGENT_NPUB_SUPPORT=npub_hex_or_placeholder
AGENT_NSEC_MARKETING=npub_hex_or_placeholder
AGENT_NPUB_MARKETING=npub_hex_or_placeholder
AGENT_NSEC_CONFORMITE=npub_hex_or_placeholder
AGENT_NPUB_CONFORMITE=npub_hex_or_placeholder

# --- Presidio (anonymisation PII, anonymiseur interne) ---
PRESIDIO_URL=http://presidio-analyzer:3000

# --- Gitea (dépôts locaux) ---
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3000/
GITEA_ADMIN_USER=toto-admin
GITEA_ADMIN_PASSWORD=change_me_gitea
GITEA_REPO_URL=http://gitea:3000/toto/assurance-toto.git
GITEA_ACCESS_TOKEN=change_me_gitea_token   # PAT généré dans l'UI Gitea (profil → applications)

# --- SearXNG / MailHog (outils locaux, aucune API payante) ---
SEARXNG_BASE_URL=http://searxng:8080
MAILHOG_SMTP_HOST=mailhog
MAILHOG_SMTP_PORT=1025

# --- APIs macro publiques gratuites (identifiants publics, pas des secrets) ---
BDF_WEBSTAT_API=https://webstat.banque-france.fr
INSEE_MELODI_API=https://catalogue-donnees.insee.fr
GPR_INDEX_SOURCE=georisques.gouv.fr

# --- Sécurité / conformité ---
RGPD_RETENTION_DAYS=365
