# .env.example — Assurance Toto (docker-compose.lite.yml / docker-compose.yml)
# Copy to `.env` (`cp .env.example .env`) then fill in.
# NO real secrets here — generated secrets only live in `.env` (gitignored).
# DNS-safe : internal hostnames comply with RFC 1123.

# --- Business PostgreSQL (service `postgres`, pgvector/pgvector:pg16) ---
PG_DB=assurance_toto
PG_USER=toto
PG_PASSWORD=change_me_pg                              # generate: openssl rand -hex 24
PG_HOST=postgres                                      # internal compose hostname (host access = localhost:PG_PORT)
PG_PORT=5434                                          # host port (change if already taken by another local Postgres)

# --- Redis (service `redis`, password mandatory) ---
REDIS_PASSWORD=change_me_redis                        # generate: openssl rand -hex 24

# --- Buzz: relay database (service `postgres-buzz`, SEPARATE from business DB) ---
BUZZ_PG_DB=buzz
BUZZ_PG_USER=buzz
BUZZ_PG_PASSWORD=change_me_buzz_pg                    # generate: openssl rand -hex 24

# --- Buzz: local media S3 storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_minio                   # >= 8 characters
BUZZ_S3_ACCESS_KEY=minioadmin                         # demo: reuses MinIO root account
BUZZ_S3_SECRET_KEY=change_me_minio
BUZZ_S3_BUCKET=buzz-media

# --- Buzz: Nostr identity (relay + bridge) ---
# Generate relay keypair + derive npub/hex:
#   cd buzz-hermes-bridge && npm run init-buzz-keys
BUZZ_RELAY_PRIVATE_KEY=nsec_hex_or_placeholder        # relay nsec (hex 64) — never commit
RELAY_OWNER_PUBKEY=npub_hex_or_placeholder            # relay pubkey (hex 64 = CEO identity)
BUZZ_PRIVATE_KEY=nsec_hex_or_placeholder              # bridge nsec (hex 64 or nsec1...) — absent => NullCollabAdapter
BRIDGE_CEOPUBKEYS=npub_hex_or_placeholder             # CSV of npub/hex CEO whitelist — no CEO signature => deny
BRIDGE_ALLOWED_UNSIGNED_ROLES=npub_hex_or_placeholder # CSV npub/hex accepted WITHOUT signature (Phase 1, NEVER a CEO npub)

# --- Bridge / settlement policy ---
CLAIM_SETTLEMENT_THRESHOLD_EUR=5000                   # above this, claim settlement requires CEO approval
HERMES_ESCALATION_THRESHOLD_EUR=5000                  # agent -> CEO escalation threshold
BRIDGE_REQUIRE_SIGNED_COMMANDS=false                  # demo local ; PROD = true (commands require signed Nostr event)

# --- Ollama (native on Windows host, NEVER as container) ---
# gemma4:e4b (9.6 GB) was chosen : local, free, tool calling compatible.
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_PRIMARY=gemma4:e4b
OLLAMA_MODEL_LONG_CTX=gemma4:e4b-16k
OLLAMA_MODEL_FALLBACK=hermes3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text                   # 768 dims — used for PGVector memoire_agents
OLLAMA_CONTEXT_SIZE=8192

# --- Hermes agents : approval mode / thresholds ---
HERMES_APPROVAL_MODE=on-risk                          # on-risk | always | never
HERMES_LOG_LEVEL=info

# --- Per-agent Nostr identities (one npub/nsec per department ; never commit nsec) ---
# npub values are public - safe in logs/audit ; nsec are private secrets.
AGENT_NSEC_ORCHESTRATEUR=nsec_hex_or_placeholder
AGENT_NPUB_ORCHESTRATEUR=npub_hex_or_placeholder
AGENT_NSEC_SALES=nsec_hex_or_placeholder
AGENT_NPUB_SALES=npub_hex_or_placeholder
AGENT_NSEC_SOUSCRIPTION=nsec_hex_or_placeholder
AGENT_NPUB_SOUSCRIPTION=npub_hex_or_placeholder
AGENT_NSEC_SINISTRES=nsec_hex_or_placeholder
AGENT_NPUB_SINISTRES=npub_hex_or_placeholder
AGENT_NSEC_FINANCE=nsec_hex_or_placeholder
AGENT_NPUB_FINANCE=npub_hex_or_placeholder
AGENT_NSEC_SUPPORT=nsec_hex_or_placeholder
AGENT_NPUB_SUPPORT=npub_hex_or_placeholder
AGENT_NSEC_MARKETING=nsec_hex_or_placeholder
AGENT_NPUB_MARKETING=npub_hex_or_placeholder
AGENT_NSEC_CONFORMITE=nsec_hex_or_placeholder
AGENT_NPUB_CONFORMITE=npub_hex_or_placeholder

# --- Privacy : Presidio (PII anonymisation before LLM / Buzz) ---
PRESIDIO_URL=http://presidio-analyzer:3000

# --- Gitea (local Git) ---
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3000/
GITEA_ADMIN_USER=toto-admin
GITEA_ADMIN_PASSWORD=change_me_gitea                  # generate: openssl rand -hex 24
GITEA_REPO_URL=http://gitea:3000/toto/assurance-toto.git
GITEA_ACCESS_TOKEN=change_me_gitea_token              # from Gitea UI → PAT

# --- Simulation tools ---
SEARXNG_BASE_URL=http://searxng:8080
MAILHOG_SMTP_HOST=mailhog
MAILHOG_SMTP_PORT=1025

# --- Public macro economic APIs (free, no key required) ---
BDF_WEBSTAT_API=https://webstat.banque-france.fr      # Banque de France rates
INSEE_MELODI_API=https://catalogue-donnees.insee.fr
GPR_INDEX_SOURCE=georisques.gouv.fr

# --- Compliance / data retention (synthetic demo only) ---
RGPD_RETENTION_DAYS=365
