# ============================================
# .env.lite.example — Configuration allégée
# Pour setup Windows 11 avec Gemma 8B / Qwen2.5 7B (sans GPU dédié puissant)
# ============================================

# --- PostgreSQL ---
PG_USER=toto_admin
PG_PASSWORD=changeme_local_password
PG_DB=assurance_toto
PG_HOST=postgres
PG_PORT=5432

# --- Ollama (tourne nativement sur Windows, pas en conteneur) ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL_PRIMARY=qwen2.5-coder:7b
OLLAMA_MODEL_FALLBACK=gemma4:e4b
OLLAMA_CONTEXT_SIZE=32768

# --- Hermes Agent ---
HERMES_APPROVAL_MODE=on-risk
HERMES_ESCALATION_THRESHOLD_EUR=5000
HERMES_LOG_LEVEL=info

# --- Gitea (local) ---
GITEA_ADMIN_USER=toto_ceo
GITEA_ADMIN_PASSWORD=changeme_local_password
GITEA_DOMAIN=gitea
GITEA_ROOT_URL=http://gitea:3000/
GITEA_ACCESS_TOKEN=
GITEA_REPO_URL=http://gitea:3000/toto/assurance-toto.git

# --- Rocket.Chat ---
ROCKETCHAT_ADMIN_USER=toto_admin
ROCKETCHAT_ADMIN_PASSWORD=changeme_local_password

# --- MailHog ---
MAILHOG_SMTP_HOST=mailhog
MAILHOG_SMTP_PORT=1025

# --- SearXNG ---
SEARXNG_BASE_URL=http://searxng:8080

# --- APIs macro publiques (gratuites) ---
BDF_WEBSTAT_API=https://webstat.banque-france.fr/api
INSEE_MELODI_API=https://api.insee.fr
GPR_INDEX_SOURCE=https://www.matteoiacoviello.com/gpr.htm

# --- Sécurité ---
PRESIDIO_ANALYZER_URL=http://mcp-presidio:5001
RGPD_RETENTION_DAYS=90

# --- Notes setup allégé ---
# Agents actifs recommandés au démarrage : orchestrateur, sales, souscription, sinistres-contentieux
# Ajouter finance, support, marketing, rh, conformite-it progressivement une fois le pipeline validé.
